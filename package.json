{
  "name": "better-updates",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@expo/code-signing-certificates": "^0.0.7",
    "@types/node-forge": "^1.3.14",
    "bun-types": "^1.4.5",
    "node-forge": "^1.4.3",
